# OpenLabel configuration. Copy to .env and adjust. Every variable is validated at start-up.

# --- Web
WEB_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Database (PostgreSQL)
POSTGRES_USER=openlabel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=openlabel
# Used by the app; inside Docker Compose the host is the "postgres" service.
DATABASE_URL=postgres://openlabel:change-me-postgres@postgres:5432/openlabel

# --- Object storage
# "s3" (bundled SeaweedFS, AWS S3, R2, GCS-interop, any S3-compatible service) or "local" (single-node disk)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=openlabel
S3_ACCESS_KEY_ID=openlabel
S3_SECRET_ACCESS_KEY=change-me-storage-secret
S3_FORCE_PATH_STYLE=true

