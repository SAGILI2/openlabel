# OpenLabel configuration. Copy to .env and adjust. Every variable is validated at start-up.

# --- Web
WEB_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Authentication
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-32-plus-character-secret
# "false" = only the first user and invited users can sign up
AUTH_ALLOW_SIGNUP=true
# Minimum password length (6-128)
AUTH_PASSWORD_MIN_LENGTH=6
# Optional Google sign-in (both or neither)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Pre-labelling
# Any service answering POST /predict with a canonical OCR page (bundled: docTR on CPU).
OCR_SERVICE_URL=http://ocr:8000
# Jobs each worker runs at once; scale further with `docker compose up --scale worker=N`.
WORKER_CONCURRENCY=2

# --- Database (PostgreSQL)
POSTGRES_USER=openlabel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=openlabel
# Used by the app; inside Docker Compose the host is the "postgres" service.
DATABASE_URL=postgres://openlabel:change-me-postgres@postgres:5432/openlabel

# --- Object storage
# "s3" (bundled SeaweedFS, AWS S3, R2, GCS-interop, any S3-compatible service) or "local" (single-node disk)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=openlabel
S3_ACCESS_KEY_ID=openlabel
S3_SECRET_ACCESS_KEY=change-me-storage-secret
S3_FORCE_PATH_STYLE=true


# --- Email
# "log" prints mail in the worker log (default), "smtp" sends through any SMTP server, "noop" drops it.
# Local testing: `docker compose --profile mail up -d` starts Mailpit; set MAIL_TRANSPORT=smtp,
# SMTP_HOST=mailpit, SMTP_PORT=1025 and open http://localhost:8025 to read the mail.
# Mailtrap: sandbox.smtp.mailtrap.io catches mail; live.smtp.mailtrap.io delivers to real people.
MAIL_TRANSPORT=log
MAIL_FROM=OpenLabel <no-reply@openlabel.local>
# Send every message to this inbox instead (staging, development)
# MAIL_REDIRECT_ALL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# "true" for implicit TLS on port 465
# SMTP_SECURE=false
