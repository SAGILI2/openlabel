{
  "name": "@openlabel/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate/cli.js",
    "check:drift": "node check-drift.mjs",
    "check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11"
  }
}
